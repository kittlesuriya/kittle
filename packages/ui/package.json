{
  "name": "kittle-ui",
  "version": "0.1.0",
  "description": "Reusable React UI for the application security and execution specification: data tables, schema forms, query builders, navigation, feedback, and UI primitives.",
  "keywords": [
    "kittle",
    "react",
    "ui",
    "component-library",
    "data-table",
    "schema-form",
    "query-builder",
    "sidebar",
    "tanstack-table",
    "tailwind",
    "typescript"
  ],
  "license": "MIT",
  "author": "Suriyaprakash",
  "repository": {
    "type": "git",
    "url": "https://github.com/kittlesuriya/kittle.git",
    "directory": "packages/ui"
  },
  "bugs": {
    "url": "https://github.com/kittlesuriya/kittle/issues"
  },
  "homepage": "https://github.com/kittlesuriya/kittle/tree/main/packages/ui",
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -b tsconfig.build.json && tsx ../../scripts/verification/rewriteBuildExtensions.ts packages/ui",
    "prepublishOnly": "npm --prefix ../.. run build",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint src --max-warnings=0",
    "test": "vitest run"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./core/form": {
      "types": "./dist/core/form/index.d.ts",
      "default": "./dist/core/form/index.js"
    },
    "./core/query": {
      "types": "./dist/core/query/index.d.ts",
      "default": "./dist/core/query/index.js"
    },
    "./core/table": {
      "types": "./dist/core/table/index.d.ts",
      "default": "./dist/core/table/index.js"
    },
    "./core/menu": {
      "types": "./dist/core/menu/index.d.ts",
      "default": "./dist/core/menu/index.js"
    },
    "./core/runtime": {
      "types": "./dist/core/runtime/index.d.ts",
      "default": "./dist/core/runtime/index.js"
    },
    "./react/data-table/hooks": {
      "types": "./dist/react/data-table/hooks/index.d.ts",
      "default": "./dist/react/data-table/hooks/index.js"
    },
    "./react/data-table/parts": {
      "types": "./dist/react/data-table/parts/index.d.ts",
      "default": "./dist/react/data-table/parts/index.js"
    },
    "./core/*": {
      "types": "./dist/core/*.d.ts",
      "default": "./dist/core/*.js"
    },
    "./react/*": {
      "types": "./dist/react/*.d.ts",
      "default": "./dist/react/*.js"
    }
  },
  "dependencies": {
    "@base-ui/react": "^1.4.0",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "date-fns": "^4.1.0",
    "input-otp": "^1.4.2",
    "next-themes": "^0.4.6",
    "tailwind-merge": "^3.5.0"
  },
  "peerDependencies": {
    "@tanstack/react-form": "^1.29.0",
    "@tanstack/react-query": "^5.99.0",
    "@tanstack/react-table": "^9.2.4",
    "lucide-react": "^1.8.0",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "react-i18next": "^17.0.4",
    "sonner": "^2.0.7",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "jsdom": "^28.1.0"
  }
}
