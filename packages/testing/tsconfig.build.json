{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "composite": true,
    "noEmit": false,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "rootDir": "src",
    "outDir": "dist",
    "baseUrl": ".",
    "paths": {
      "kittle-core": ["../core/dist/index.d.ts"],
      "kittle-core/*": ["../core/dist/*"],
      "kittle-adapters": ["../adapters/dist/index.d.ts"],
      "kittle-adapters/*": ["../adapters/dist/*"]
    }
  },
  "references": [
    { "path": "../core/tsconfig.build.json" },
    { "path": "../adapters/tsconfig.build.json" }
  ],
  "include": ["src"]
}
