{
  "name": "kittle-adapters",
  "version": "0.1.0",
  "description": "Drizzle (D1/Postgres), HTTP, cache, and server adapters implementing the kittle-core ports.",
  "keywords": [
    "typescript",
    "drizzle-orm",
    "cloudflare-d1",
    "postgres",
    "http",
    "cache",
    "multi-tenancy"
  ],
  "license": "MIT",
  "author": "Suriyaprakash",
  "type": "module",
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -b tsconfig.build.json && tsx ../../scripts/verification/rewriteBuildExtensions.ts packages/adapters",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint src --max-warnings=0",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./http": {
      "types": "./dist/http/index.d.ts",
      "default": "./dist/http/index.js"
    },
    "./server": {
      "types": "./dist/server/index.d.ts",
      "default": "./dist/server/index.js"
    },
    "./drizzle-d1": {
      "types": "./dist/drizzle-d1/index.d.ts",
      "default": "./dist/drizzle-d1/index.js"
    },
    "./drizzle-pg": {
      "types": "./dist/drizzle-pg/index.d.ts",
      "default": "./dist/drizzle-pg/index.js"
    },
    "./cache": {
      "types": "./dist/cache/index.d.ts",
      "default": "./dist/cache/index.js"
    },
    "./utils/redact": {
      "types": "./dist/utils/redact.d.ts",
      "default": "./dist/utils/redact.js"
    }
  },
  "dependencies": {
    "kittle-core": "^0.1.0",
    "drizzle-orm": "^0.45.2",
    "uuidv7": "^1.2.1",
    "zod": "^4.3.6"
  }
}
