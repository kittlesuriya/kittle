{
  "name": "kittle-adapters",
  "version": "0.4.2",
  "description": "Production HTTP, database, cache, and execution adapters for the application security and execution specification.",
  "keywords": [
    "kittle",
    "http",
    "rest-api",
    "crud",
    "drizzle",
    "postgresql",
    "mysql",
    "cloudflare-d1",
    "cloudflare-workers",
    "multi-tenant",
    "abac",
    "authorization",
    "idempotency",
    "optimistic-concurrency",
    "audit-log",
    "outbox-pattern",
    "rate-limiting",
    "caching",
    "durable-jobs",
    "typescript"
  ],
  "license": "MIT",
  "author": "Suriyaprakash",
  "repository": {
    "type": "git",
    "url": "https://github.com/kittlesuriya/kittle.git",
    "directory": "packages/adapters"
  },
  "bugs": {
    "url": "https://github.com/kittlesuriya/kittle/issues"
  },
  "homepage": "https://github.com/kittlesuriya/kittle/tree/main/packages/adapters",
  "type": "module",
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -b tsconfig.build.json && tsx ../../scripts/verification/rewriteBuildExtensions.ts packages/adapters",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint src --max-warnings=0",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./http": {
      "types": "./dist/http/index.d.ts",
      "default": "./dist/http/index.js"
    },
    "./server": {
      "types": "./dist/server/index.d.ts",
      "default": "./dist/server/index.js"
    },
    "./drizzle-d1": {
      "types": "./dist/drizzle-d1/index.d.ts",
      "default": "./dist/drizzle-d1/index.js"
    },
    "./drizzle-pg": {
      "types": "./dist/drizzle-pg/index.d.ts",
      "default": "./dist/drizzle-pg/index.js"
    },
    "./cache": {
      "types": "./dist/cache/index.d.ts",
      "default": "./dist/cache/index.js"
    },
    "./utils/redact": {
      "types": "./dist/utils/redact.d.ts",
      "default": "./dist/utils/redact.js"
    },
    "./drizzle-mysql": {
      "types": "./dist/drizzle-mysql/index.d.ts",
      "default": "./dist/drizzle-mysql/index.js"
    },
    "./fastify": {
      "types": "./dist/fastify/index.d.ts",
      "default": "./dist/fastify/index.js"
    },
    "./nestjs": {
      "types": "./dist/nestjs/index.d.ts",
      "default": "./dist/nestjs/index.js"
    }
  },
  "dependencies": {
    "drizzle-orm": "^0.45.2",
    "fastify": "^5.12.5",
    "kittle-core": "^0.3.0",
    "uuidv7": "^1.2.1",
    "zod": "^4.3.6"
  },
  "peerDependencies": {
    "@nestjs/common": "^10.0.0 || ^11.0.0"
  },
  "peerDependenciesMeta": {
    "@nestjs/common": {
      "optional": true
    }
  },
  "devDependencies": {
    "@nestjs/common": "^11.2.6"
  }
}
